#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "${repository_root}/backend"
uv run --locked --no-sync ruff format --check src tests migrations
uv run --locked --no-sync ruff check src tests migrations
uv run --locked --no-sync pyright
uv run --locked --no-sync pytest

"${repository_root}/scripts/semantic-check"

"${repository_root}/scripts/db-check"

cd "${repository_root}/frontend"
npm run format:check
npm run lint
npm run typecheck
npm test
npm run test:e2e
npm run build
